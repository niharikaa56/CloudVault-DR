# MONGODB_URI: MongoDB Atlas connection string (required for database & GridFS storage).
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cloud_disaster_recovery?retryWrites=true&w=majority
MONGODB_URI=

# PORT: Server port (defaults to 3000 in AI Studio).
PORT=3000

# APP_URL: Public URL where this applet is hosted.
APP_URL="MY_APP_URL"
